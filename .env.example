# Server
PORT=3000

# Prisma connection string
# Remplacer par la chaîne de connexion PostgreSQL fournie par Supabase
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=public

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
SUPABASE_SECRET_KEY=<your-secret-key>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# JWT
JWT_SECRET=<your-jwt-secret>
# Access token lifetime (for example: 15m, 1h, or 2h)
ACCESS_TOKEN_EXPIRES_IN=1h

# Invitation email delivery
# Use "console" locally until the Brevo account is ready.
MAIL_PROVIDER=console
APP_URL=http://localhost:5173
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Konstrukt
# Required only when MAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_INVITATION_TEMPLATE_ID=2